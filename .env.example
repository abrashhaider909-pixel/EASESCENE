# ---- Shared database (optional but recommended for real use) -------------
# Without these, EzScene runs entirely on browser storage (one device only).
# Create a Supabase project, run supabase/schema.sql in its SQL editor, then:
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key"

# ---- Help assistant (optional) --------------------------------------------
# Server-side only (never prefixed with VITE_). Without it the assistant
# answers from built-in help text.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"

# ---- Branding ---------------------------------------------------------------
VITE_UNIVERSITY_NAME="EzScene University"
VITE_SUPPORT_EMAIL="support@uni.edu.pk"
# Public URL printed in the PDF QR codes (defaults to the current site)
VITE_PUBLIC_URL=""

# ---- Hackathon / open source ---------------------------------------------
# One-click demo accounts on the landing page (turn off for real use)
VITE_DEMO_MODE="true"
# Public GitHub repository shown in the footer and About page
VITE_REPO_URL="https://github.com/your-team/ezscene"
